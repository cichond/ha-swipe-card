{
  "name": "ha-swipe-card",
  "version": "1.0.0",
  "description": "Lovelace swipe card that can switch the visible card by the state of an entity assigned to the viewer.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": "https://github.com/cichond/ha-swipe-card",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "rollup": "^4.65.1",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
